<Window
    x:Class="StableVolume.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,28,32,32" Spacing="20" MaxWidth="600">

            <StackPanel Spacing="4">
                <TextBlock Text="Stable Volume" FontSize="36" FontWeight="Bold" />
                <TextBlock Text="Set a level once. Windows and apps can't move it."
                           Opacity="0.7" TextWrapping="Wrap" FontSize="15" />
            </StackPanel>

            <Border CornerRadius="28" Padding="28,24" Background="#D8F45F">
                <StackPanel Spacing="2">
                    <TextBlock Text="SYSTEM VOLUME RIGHT NOW" FontSize="12" FontWeight="SemiBold"
                               Foreground="#2A2D12" />
                    <TextBlock x:Name="CurrentText" Text="--%" FontSize="76" FontWeight="Black"
                               Foreground="#14160A" />
                    <TextBlock x:Name="DeviceText" Text="" FontSize="14" Foreground="#2A2D12"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border CornerRadius="24" Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="18">

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Hold volume" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="HoldSwitch" HorizontalAlignment="Right"
                                      OnContent="" OffContent="" MinWidth="0"
                                      Toggled="HoldSwitch_Toggled" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="TargetLabel" Text="Volume to hold: 40%" FontSize="16"
                                   FontWeight="SemiBold" />
                        <Slider x:Name="TargetSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                SmallChange="1" LargeChange="5" Value="40" Height="44"
                                ValueChanged="TargetSlider_ValueChanged" />
                    </StackPanel>

                    <Button x:Name="UseCurrentButton" Content="Use current level"
                            HorizontalAlignment="Stretch" Height="56" CornerRadius="16" FontSize="16"
                            Click="UseCurrentButton_Click" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Mode" FontSize="16" FontWeight="SemiBold" />
                        <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" Height="44"
                                  SelectionChanged="ModeBox_SelectionChanged">
                            <ComboBoxItem Content="Lock exactly at this level" />
                            <ComboBoxItem Content="Never louder than this level" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="UnmuteCheck" Content="Keep unmuted" Click="Option_Click" />
                    <CheckBox x:Name="StartupCheck" Content="Start with Windows (minimized)"
                              Click="Option_Click" />
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="13"
                       Text="Stable Volume guards the master volume of your default playback device and snaps it back within a blink when anything changes it. It keeps working while minimized; closing the window stops it. It does not change how loud individual songs or videos are." />
        </StackPanel>
    </ScrollViewer>
</Window>
